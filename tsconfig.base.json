{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "@descent/shared": ["packages/shared/src/index.ts"],
      "@descent/game": ["packages/game/src/index.ts"],
      "@descent/content": ["packages/content/src/index.ts"],
      "@descent/assets": ["packages/assets/src/index.ts"]
    }
  }
}

