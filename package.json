{
  "name": "descent-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "bootstrap": "node ./scripts/bootstrap.mjs",
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @descent/web dev --host 127.0.0.1 --port 5173",
    "dev:api": "pnpm --filter @descent/api dev",
    "start:prod": "node ./start-production.mjs",
    "build": "turbo run build",
    "build:web": "pnpm --filter @descent/web build",
    "build:api": "pnpm --filter @descent/api build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "turbo run test:unit --parallel",
    "test:integration": "pnpm --filter @descent/api test:integration && pnpm vitest run tests/integration",
    "test:e2e": "playwright test",
    "content:validate": "pnpm --filter @descent/content validate",
    "content:build": "pnpm --filter @descent/content build",
    "asset:validate": "pnpm --filter @descent/assets validate",
    "asset:build": "pnpm --filter @descent/assets build",
    "db:migrate": "pnpm --filter @descent/api db:migrate",
    "db:seed": "pnpm --filter @descent/api db:seed",
    "db:reset": "pnpm --filter @descent/api db:reset",
    "verify": "pnpm content:validate && pnpm asset:validate && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.54.2",
    "@types/node": "^24.6.0",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
